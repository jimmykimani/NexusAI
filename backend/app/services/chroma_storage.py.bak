import logging
from typing import Any
import chromadb
from chromadb.utils import embedding_functions
import json
from app.core.config import settings

logger = logging.getLogger(__name__)

_client = None
_collection = None

def _get_collection():
    global _client, _collection
    if _collection is None:
        try:
            # Persistent client in the workspace
            _client = chromadb.PersistentClient(path="./chroma_db")
            # Default embedding function (sentence-transformers if local, or we can use OpenAI)
            # For demo, using default local embeddings to avoid extra API costs
            emb_fn = embedding_functions.DefaultEmbeddingFunction()
            
            _collection = _client.get_or_create_collection(
                name="nexus_search_cache",
                embedding_function=emb_fn
            )
        except Exception as exc:
            logger.error(f"Failed to initialize ChromaDB: {exc}")
            raise
    return _collection

def store_search(query: str, criteria: dict[str, Any]):
    """Store a query and its resolved criteria in semantic memory."""
    try:
        col = _get_collection()
        col.add(
            documents=[query],
            metadatas=[{"criteria": json.dumps(criteria)}],
            ids=[f"q_{hash(query)}"]
        )
        logger.debug(f"Stored query in ChromaDB: {query[:50]}")
    except Exception as exc:
        logger.warning(f"ChromaDB store failed: {exc}")

def query_semantic_cache(query: str, threshold: float = 0.85) -> dict[str, Any] | None:
    """Find a semantically similar search and return its criteria."""
    try:
        col = _get_collection()
        results = col.query(
            query_texts=[query],
            n_results=1
        )
        
        if not results or not results["distances"] or not results["distances"][0]:
            return None
            
        distance = results["distances"][0][0]
        # Chroma distances: lower is better (0.0 is perfect match)
        # Default local embeddings use cosine distance or L2? Default is squared L2.
        # We'll use a conservative distance check.
        if distance < 0.25: # Very similar
            meta = results["metadatas"][0][0]
            logger.info(f"ChromaDB semantic hit for: {query[:50]} (dist={distance:.4f})")
            return json.loads(meta["criteria"])
            
    except Exception as exc:
        logger.warning(f"ChromaDB query failed: {exc}")
        
    return None
