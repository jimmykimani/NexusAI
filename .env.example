# === LLMs ===
# Provider: openai | anthropic | groq | openrouter
LLM_PROVIDER=groq

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME
GROQ_API_KEY=gsk_REPLACE_ME
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Model ids for openai / groq / openrouter (vendor-specific slugs).
# Cheap dev on Groq free tier: use 8B for both. OpenRouter + Gemini (needs credits): google/gemini-2.0-flash-001
OPENAI_REASONING_MODEL=llama-3.1-8b-instant
OPENAI_FAST_MODEL=llama-3.1-8b-instant

GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=NexusAI

# === Search ===
TAVILY_API_KEY=tvly-REPLACE_ME
# Optional: Apollo People Search (merged with Tavily; no email in search endpoint).
# Any of: APOLLO_API_KEY, APOLLO_KEY, APOLLO_IO_API_KEY, APOLLO_MASTER_API_KEY
APOLLO_API_KEY=
# Apollo login email (optional). Also used as fallback for Scrupp ``account`` if SCRUPP_APOLLO_ACCOUNT is unset.
APOLLO_LOGIN_EMAIL=
# Scrupp: Apollo people export API (https://scrupp.com/docs/api/apollo). SCRUPP_KEY also works.
SCRUPP_API_KEY=
# Linked Apollo account id in Scrupp (app.scrupp.com after connecting Apollo). Not the same as APOLLO_KEY.
SCRUPP_APOLLO_ACCOUNT=
# Clay: key from Clay Settings. Short keys often validate only in-product; GET /v3/me may stay 401 until you use a workspace token.
CLAY_API_KEY=

# === Database ===
DATABASE_URL=postgresql+psycopg2://nexus:nexus@postgres:5432/nexusai

# === Auth ===
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-chars-of-random-data
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === App ===
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# === Frontend ===
VITE_API_URL=http://localhost:8000
